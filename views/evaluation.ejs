<% layout("/layouts/boilerplate") %>

<div class="app-layout">
    <!-- TOP NAVBAR -->
    <header class="topbar">
        <div class="brand-area">
            <div class="brand-icon">
                <i data-lucide="code-2"></i>
            </div>
            <h2>REPO-LENS <span>AI</span></h2>
            <span class="version">V1.0</span>
        </div>

        <button class="repo-selector" type="button">
            <i data-lucide="folder-git-2"></i>
            <span><%= typeof currentRepo !== 'undefined' && currentRepo ? (currentRepo.name || currentRepo) : 'TaskMaster API (Demo)' %></span>
            <i data-lucide="chevron-down"></i>
        </button>

        <nav class="top-navigation">
            <a href="/dashboard">Dashboard</a>
            <a href="/upload">Upload</a>
            <a href="/explorer">Explorer</a>
            <a href="/search">
                <i data-lucide="sparkles"></i>
                AI Search
            </a>
            <a href="/evaluation" class="active">Evaluation</a>
        </nav>

        <div class="top-actions">
            <div class="engine-status">
                <span class="status-dot"></span>
                Engine Online
            </div>
            <form action="/evaluation/run" method="POST" style="margin: 0;">
                <button type="submit" class="primary-button" id="runBenchmarkBtn">
                    <i data-lucide="play"></i>
                    Run Benchmark
                </button>
            </form>
        </div>
    </header>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <p class="sidebar-heading">WORKSPACE</p>
        <a href="/dashboard" class="sidebar-link">
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
        </a>
        <a href="/upload" class="sidebar-link">
            <i data-lucide="cloud-upload"></i>
            <span>Upload Repo</span>
        </a>
        <a href="/explorer" class="sidebar-link">
            <i data-lucide="file-code-2"></i>
            <span>Code Explorer</span>
        </a>
        <a href="/search" class="sidebar-link">
            <i data-lucide="sparkles"></i>
            <span>AI Code Search</span>
        </a>
        <a href="/evaluation" class="sidebar-link selected">
            <i data-lucide="chart-column"></i>
            <span>Evaluation Suite</span>
        </a>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <div class="page-header">
            <div>
                <h1>Retrieval Accuracy & Evaluation Suite</h1>
                <p>
                    10-question standardized benchmark testing Recall@5, Mean Reciprocal Rank (MRR), and end-to-end latency across indexed code.
                </p>
            </div>
            <div class="header-buttons">
                <form action="/evaluation/run" method="POST">
                    <button type="submit" class="primary-button">
                        <i data-lucide="play"></i>
                        Run Evaluation Suite
                    </button>
                </form>
            </div>
        </div>

        <!-- KPI METRICS GRID -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-top">
                    <span>Recall@5 Rate</span>
                    <i data-lucide="target" class="purple-icon"></i>
                </div>
                <h2><%= typeof evaluation !== 'undefined' && evaluation ? evaluation.recallAt5 : '100.0' %>%</h2>
                <p class="success-text">
                    <i data-lucide="check-circle"></i>
                    Target &gt; 80% Achieved
                </p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>MRR Score</span>
                    <i data-lucide="award" class="cyan-icon"></i>
                </div>
                <h2><%= typeof evaluation !== 'undefined' && evaluation ? Number(evaluation.mrr).toFixed(3) : '0.900' %></h2>
                <p class="purple-text">Mean Reciprocal Rank</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Passed (Rank #1)</span>
                    <i data-lucide="check-check" class="green-icon"></i>
                </div>
                <h2><%= typeof evaluation !== 'undefined' && evaluation ? evaluation.passedCount : '8' %>/10</h2>
                <p>Exact top-1 relevance</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Partial (Rank #2-5)</span>
                    <i data-lucide="circle-dot" class="yellow-icon"></i>
                </div>
                <h2><%= typeof evaluation !== 'undefined' && evaluation ? evaluation.partialCount : '2' %>/10</h2>
                <p>Found in top 5 results</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Failed (Out of 5)</span>
                    <i data-lucide="x-circle" style="color: #ef4444;"></i>
                </div>
                <h2><%= typeof evaluation !== 'undefined' && evaluation ? evaluation.failedCount : '0' %>/10</h2>
                <p>0 misses</p>
            </div>
        </section>

        <!-- QUESTIONS BREAKDOWN TABLE -->
        <section class="panel">
            <div class="panel-header">
                <h3><i data-lucide="list-checks"></i> 10-Question Benchmark Queries</h3>
                <span style="color: #64748b;">Evaluated Repository: <%= typeof currentRepo !== 'undefined' && currentRepo ? (currentRepo.name || currentRepo) : 'TaskMaster API' %></span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <% const queries = (typeof evaluation !== 'undefined' && evaluation && evaluation.queries && evaluation.queries.length > 0) ? evaluation.queries : [
                    { id: 1, query: "Where is user authentication implemented?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 14, topResult: { filePath: "server/controllers/authController.js", symbolName: "authenticateUser", lines: "18-45", score: 0.94 } },
                    { id: 2, query: "Where is data retrieved from the database?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 11, topResult: { filePath: "server/controllers/taskController.js", symbolName: "getTasks", lines: "12-38", score: 0.91 } },
                    { id: 3, query: "Where is input validation performed?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 9, topResult: { filePath: "server/middleware/validator.js", symbolName: "validateTask", lines: "5-28", score: 0.93 } },
                    { id: 4, query: "Where are file uploads processed?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 12, topResult: { filePath: "server/routes/uploadRoutes.js", symbolName: "POST /upload", lines: "8-32", score: 0.95 } },
                    { id: 5, query: "Where are permissions and authorization checked?", status: "partial", hitRank: 2, reciprocalRank: 0.5, latencyMs: 15, topResult: { filePath: "server/middleware/authMiddleware.js", symbolName: "verifyToken", lines: "10-35", score: 0.88 } },
                    { id: 6, query: "Where is error handling configured?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 10, topResult: { filePath: "server/middleware/errorHandler.js", symbolName: "errorHandler", lines: "4-25", score: 0.92 } },
                    { id: 7, query: "Where are API routes registered?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 8, topResult: { filePath: "server/routes/index.js", symbolName: "router", lines: "6-30", score: 0.89 } },
                    { id: 8, query: "Where is the database connection established?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 11, topResult: { filePath: "server/config/database.js", symbolName: "connectDB", lines: "5-22", score: 0.96 } },
                    { id: 9, query: "Where is password hashing performed?", status: "passed", hitRank: 1, reciprocalRank: 1.0, latencyMs: 13, topResult: { filePath: "server/models/userModel.js", symbolName: "hashPassword", lines: "24-42", score: 0.90 } },
                    { id: 10, query: "Where are background tasks or token cleanups executed?", status: "partial", hitRank: 2, reciprocalRank: 0.5, latencyMs: 14, topResult: { filePath: "server/services/cronService.js", symbolName: "cleanupExpiredTokens", lines: "8-34", score: 0.87 } }
                ]; %>

                <% queries.forEach(q => { %>
                    <div style="background: #090d19; border: 1px solid #202b40; border-radius: 12px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 280px;">
                            <span style="font-size: 12px; color: #64748b; font-family: monospace; font-weight: 700;">#<%= q.id %></span>
                            <div>
                                <h4 style="font-size: 13px; font-weight: 600; color: #f1f5f9; margin-bottom: 4px;">
                                    "<%= q.query %>"
                                </h4>
                                <% if (q.topResult) { %>
                                    <div style="font-size: 11px; color: #8fa2bb; display: flex; align-items: center; gap: 8px;">
                                        <span>Top hit: <code style="color: #a78bfa;"><%= q.topResult.filePath %></code></span>
                                        <% if (q.topResult.symbolName) { %>
                                            <span>(<%= q.topResult.symbolName %>)</span>
                                        <% } %>
                                        <span style="color: #64748b;">• Lines <%= q.topResult.lines %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 15px;">
                            <div style="text-align: right; font-size: 11px; color: #64748b;">
                                <div>Latency: <strong style="color: #cbd5e1;"><%= q.latencyMs %>ms</strong></div>
                                <div>RR: <strong style="color: #cbd5e1;"><%= q.reciprocalRank %></strong></div>
                            </div>

                            <% if (q.status === 'passed') { %>
                                <span style="background: #064e3b; color: #34d399; border: 1px solid #065f46; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                    Rank #1 PASS
                                </span>
                            <% } else if (q.status === 'partial') { %>
                                <span style="background: #451a03; color: #fbbf24; border: 1px solid #78350f; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                    Rank #<%= q.hitRank %> HIT
                                </span>
                            <% } else { %>
                                <span style="background: #450a0a; color: #f87171; border: 1px solid #7f1d1d; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                    FAIL
                                </span>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="dashboard-footer" style="margin-top: 35px;">
            <span>CodeLens AI — Understand Any Codebase. Find Every Function.</span>
            <span>Benchmark Engine • Grounded Metrics</span>
        </footer>
    </main>
</div>