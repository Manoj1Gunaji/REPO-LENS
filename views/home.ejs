<% layout("/layouts/boilerplate") %>

    <!-- Developer Productivity Section -->

    <section class="section">
        <div class="container">

            <div class="section-title">
                <h2>Architected for Developer Productivity</h2>
                <p>
                    Everything you need to navigate unfamiliar codebases in seconds.
                </p>
            </div>

            <div class="feature-grid">

                <div class="feature-card">
                    <div class="icon-box purple">
                        <i data-lucide="brain-circuit"></i>
                    </div>

                    <h3>Hybrid Retrieval Engine</h3>

                    <p>
                        Combines Okapi BM25 lexical matching, AST symbol
                        extraction, and vector similarity with configurable
                        weights for maximum precision.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="icon-box violet">
                        <i data-lucide="code-2"></i>
                    </div>

                    <h3>Exact Line Grounding</h3>

                    <p>
                        Never invent files or line numbers. Every response
                        is tied to verified source-code ranges with exact
                        line-level navigation.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="icon-box teal">
                        <i data-lucide="shield-check"></i>
                    </div>

                    <h3>Security & ZIP Slip Defense</h3>

                    <p>
                        Strict path traversal checks, decompressed size
                        limits, entry count limits, and isolated repository
                        handling ensure safe code processing.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <div class="container">
        <hr class="divider">
    </div>

    <!-- How CodeLens AI Works -->

    <section class="section">
        <div class="container">

            <div class="section-title">
                <h2>How CodeLens AI Works</h2>
                <p>
                    From ZIP upload to natural language code intelligence
                    in 4 straightforward stages.
                </p>
            </div>

            <div class="steps-grid">

                <div class="step-card">
                    <div class="step-top">
                        <span class="step-number">01</span>
                        <i data-lucide="folder-up" class="step-icon"></i>
                    </div>

                    <h3>Upload & Extract</h3>

                    <p>
                        Upload a ZIP archive or select a local repository.
                        Safe extraction validates boundaries and excludes
                        build artifacts.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-top">
                        <span class="step-number">02</span>
                        <i data-lucide="scan-search" class="step-icon"></i>
                    </div>

                    <h3>Parse & Extract Symbols</h3>

                    <p>
                        Extract functions, classes, methods, constructors,
                        interfaces, and imports with accurate line-based
                        parsing.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-top">
                        <span class="step-number">03</span>
                        <i data-lucide="database" class="step-icon"></i>
                    </div>

                    <h3>Build Search Indexes</h3>

                    <p>
                        Combine BM25 lexical frequencies, extracted
                        symbol indexes, and semantic vector embeddings.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-top">
                        <span class="step-number">04</span>
                        <i data-lucide="search" class="step-icon"></i>
                    </div>

                    <h3>Search & Explain</h3>

                    <p>
                        Query in plain English. Retrieve relevant snippets
                        and receive grounded technical explanations.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- Footer -->

    <footer>
        <div class="footer-content">

            <div class="brand">
                <strong>✦ CodeLens AI</strong>
                — Understand Any Codebase. Find Every Function.
            </div>

            <div class="copyright">
                © 2026 CodeLens AI. All rights reserved.
            </div>

        </div>
    </footer>

    <script>
        lucide.createIcons();
    </script>

