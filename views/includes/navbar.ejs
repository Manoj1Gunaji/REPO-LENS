<header class="topbar">
    <div class="brand-area">
        <div class="brand-icon">
            <i data-lucide="code-2"></i>
        </div>
        <h2>REPO-LENS <span>AI</span></h2>
        <span class="version">V1.0</span>
    </div>

    <button class="repo-selector" type="button">
        <i data-lucide="folder-git-2"></i>
        <span><%= typeof currentRepo !== 'undefined' && currentRepo ? (currentRepo.name || currentRepo) : 'TaskMaster API (Demo)' %></span>
        <i data-lucide="chevron-down"></i>
    </button>

    <nav class="top-navigation">
        <a href="/dashboard" class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/upload" class="<%= typeof activePage !== 'undefined' && activePage === 'upload' ? 'active' : '' %>">Upload</a>
        <a href="/explorer" class="<%= typeof activePage !== 'undefined' && activePage === 'explorer' ? 'active' : '' %>">Explorer</a>
        <a href="/search" class="<%= typeof activePage !== 'undefined' && activePage === 'search' ? 'active' : '' %>">
            <i data-lucide="sparkles"></i>
            AI Search
        </a>
        <a href="/evaluation" class="<%= typeof activePage !== 'undefined' && activePage === 'evaluation' ? 'active' : '' %>">Evaluation</a>
    </nav>

    <div class="top-actions">
        <div class="engine-status">
            <span class="status-dot"></span>
            Engine Online
        </div>

        <a href="/search" class="ask-button">
            <i data-lucide="sparkles"></i>
            Ask Question
        </a>
    </div>
</header>